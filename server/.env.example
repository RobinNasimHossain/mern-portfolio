NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/mern_portfolio

# JWT secrets — MUST be long random strings in production
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed credentials (only used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@robinnasim.dev
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_ADMIN_NAME=Robin Nasim Hossain
